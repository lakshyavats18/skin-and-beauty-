            "subtitle": "30-day effortless guarantee"
          }
        },
        "badge_3": {
          "type": "badge",
          "settings": {
            "icon": "shipping",
            "title": "Global Delivery",
            "subtitle": "Carbon neutral logistics"
          }
        }
      },
      "block_order": [
        "badge_1",
        "badge_2",
        "badge_3"
      ]
