{
  "sections": {
    "main": {
      "type": "main-page",
      "blocks": {
        "content": {
          "type": "text",
          "name": "t:names.content",
          "settings": {
            "text": "{{ closest.page.content }}",
            "width": "100%",
            "max_width": "narrow",
            "alignment": "center",
            "type_preset": "rte",
            "font": "var(--font-primary--family)",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        }
      },
      "block_order": [
        "content"
      ],
      "settings": {
        "content_direction": "column",
        "gap": 32,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 40,
        "padding-block-end": 0
      }
    },
    "form": {
      "type": "section",
      "blocks": {
