{% comment %}
  Luxury Skincare FAQ Section
  Features accordion schema blocks + automatic page.content fallback parsing
{% endcomment %}

<div class="luxury-faq-wrapper" id="luxury-faq-{{ section.id }}">
  <div class="page-width">
    
    <!-- Section Header -->
    <div class="luxury-faq__header text-center">
      {% if section.settings.kicker != blank %}
        <span class="luxury-kicker">{{ section.settings.kicker | escape }}</span>
      {% endif %}

      <h1 class="luxury-faq__title">
        {{ section.settings.title | default: page.title | default: 'Frequently Asked Questions' }}
      </h1>

      {% if section.settings.subtitle != blank %}
        <p class="luxury-faq__subtitle">{{ section.settings.subtitle | escape }}</p>
      {% endif %}
    </div>

    <!-- Structured Schema Blocks Accordion -->
    {% if section.blocks.size > 0 %}
      <div class="luxury-faq-list" data-allow-multiple="{{ section.settings.allow_multiple }}">
        {% for block in section.blocks %}
          <div class="luxury-faq-item" {{ block.shopify_attributes }}>
            <button
              type="button"
              class="luxury-faq-question"
              aria-expanded="false"
              aria-controls="faq-answer-{{ block.id }}"
            >
              <span class="luxury-faq-question-text">{{ block.settings.question | escape }}</span>
              <span class="luxury-faq-icon" aria-hidden="true">+</span>
            </button>
            <div
              id="faq-answer-{{ block.id }}"
              class="luxury-faq-answer"
            >
              <div class="luxury-faq-answer-inner rte">
                {{ block.settings.answer }}
              </div>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Page Content Fallback (Preserves any raw page content created in Shopify Admin) -->
    {% if page.content != blank %}
      <div class="luxury-faq-legacy-wrapper">
        <div class="luxury-faq-legacy-content" data-luxury-faq-content>
          {{ page.content }}
        </div>
      </div>
    {% endif %}

    <!-- Concierge Support Card -->
    {% if section.settings.show_concierge %}
      <div class="luxury-faq__concierge">
        <div class="faq-concierge__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </div>
        <div class="faq-concierge__content">
          <h3 class="faq-concierge__title">{{ section.settings.concierge_title | default: 'Require Personalized Skin Guidance?' }}</h3>
          <p class="faq-concierge__desc">{{ section.settings.concierge_desc | default: 'Our clinical skincare specialists are available for bespoke formulation recommendations.' }}</p>
        </div>
        <div class="faq-concierge__action">
          <a href="{{ section.settings.concierge_link | default: '/pages/contact' }}" class="button-primary">
            {{ section.settings.concierge_btn | default: 'Contact Concierge' }}
          </a>
        </div>
      </div>
    {% endif %}

  </div>
</div>

<style>
  #luxury-faq-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FAF7F5' }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }

  .luxury-faq__header {
    max-width: 650px;
    margin: 0 auto 3.5rem;
  }

  .luxury-faq__title {
    font-family: var(--lx-font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    font-weight: 500;
    color: var(--lx-text-primary, #2D2926);
    line-height: 1.15;
    margin: 0.5rem 0 1rem;
  }

  .luxury-faq__subtitle {
    font-family: var(--lx-font-body, 'Plus Jakarta Sans', sans-serif);
    font-size: 1rem;
    color: var(--lx-text-secondary, #6E665E);
    line-height: 1.6;
    margin: 0;
  }

  .luxury-faq-list {
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .luxury-faq-item {
    background: #FFFFFF;
    border: 1px solid var(--lx-border-subtle, #E8E2DC);
    border-radius: var(--lx-radius-md, 8px);
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .luxury-faq-item.is-open {
    border-color: rgba(158, 123, 79, 0.45);
    box-shadow: 0 8px 24px rgba(45, 41, 38, 0.05);
  }

  .luxury-faq-question {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.4rem 1.8rem;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    transition: background-color 0.2s ease;
  }

  .luxury-faq-question:hover {
    background-color: rgba(250, 247, 245, 0.5);
  }

  .luxury-faq-question-text {
    font-family: var(--lx-font-heading, 'Cormorant Garamond', serif);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--lx-text-primary, #2D2926);
    line-height: 1.3;
  }

  .luxury-faq-icon {
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--lx-gold-primary, #9E7B4F);
    margin-left: 1rem;
    transition: transform 0.3s ease;
    flex-shrink: 0;
    line-height: 1;
  }

  .luxury-faq-item.is-open .luxury-faq-icon {
    transform: rotate(45deg);
  }

  .luxury-faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .luxury-faq-answer-inner {
    padding: 0 1.8rem 1.5rem;
    font-family: var(--lx-font-body, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--lx-text-secondary, #6E665E);
  }

  .luxury-faq-legacy-wrapper {
    max-width: 820px;
    margin: 2.5rem auto 0;
  }

  .luxury-faq__concierge {
    max-width: 820px;
    margin: 4rem auto 0;
    display: flex;
    align-items: center;
    gap: 1.8rem;
    background: linear-gradient(135deg, #F5EDE6 0%, #FFFFFF 100%);
    border: 1px solid rgba(158, 123, 79, 0.25);
    border-radius: var(--lx-radius-lg, 16px);
    padding: 2.2rem;
    box-shadow: 0 8px 24px rgba(0,0,0,0.03);
  }

  .faq-concierge__icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background-color: #FFFFFF;
    border: 1px solid rgba(158, 123, 79, 0.3);
    color: var(--lx-gold-primary, #9E7B4F);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .faq-concierge__content {
    flex-grow: 1;
  }

  .faq-concierge__title {
    font-family: var(--lx-font-heading, 'Cormorant Garamond', serif);
    font-size: 1.45rem;
    font-weight: 600;
    margin: 0 0 0.3rem;
    color: var(--lx-text-primary, #2D2926);
  }

  .faq-concierge__desc {
    font-family: var(--lx-font-body, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.88rem;
    color: var(--lx-text-secondary, #6E665E);
    margin: 0;
    line-height: 1.45;
  }

  @media (max-width: 749px) {
    .luxury-faq__concierge {
      flex-direction: column;
      text-align: center;
      gap: 1.25rem;
    }
  }
</style>

{% schema %}
{
  "name": "Luxury Skincare FAQ",
  "tag": "section",
  "class": "luxury-faq-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF7F5"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Client Care & Inquiries"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Everything you need to know regarding our formulations, clinical integrity, and worldwide delivery."
    },
    {
      "type": "checkbox",
      "id": "allow_multiple",
      "label": "Allow Multiple Open Accordions",
      "default": false
    },
    {
      "type": "header",
      "content": "Concierge Contact Box"
    },
    {
      "type": "checkbox",
      "id": "show_concierge",
      "label": "Show Concierge Banner",
      "default": true
    },
    {
      "type": "text",
      "id": "concierge_title",
      "label": "Concierge Heading",
      "default": "Require Personalized Skin Guidance?"
    },
    {
      "type": "text",
      "id": "concierge_desc",
      "label": "Concierge Description",
      "default": "Our clinical skincare specialists are available for bespoke regimen recommendations."
    },
    {
      "type": "text",
      "id": "concierge_btn",
      "label": "Button Label",
      "default": "Contact Skincare Concierge"
    },
    {
      "type": "url",
      "id": "concierge_link",
      "label": "Button Link"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 90
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Are your formulations suitable for highly sensitive skin?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>Yes. Every Tenicide formulation undergoes comprehensive dermatological patch testing on sensitive skin types. Our products are formulated without parabens, sulfates, artificial fragrances, or aggressive drying alcohols.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Skincare FAQ",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "Are your formulations suitable for sensitive or sensitized skin?",
            "answer": "<p>Yes. Every Tenicide formula undergoes multi-panel clinical patch testing. We rigorously exclude known irritants including synthetic fragrances, drying alcohols, sulfates, and parabens.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How quickly can I expect to observe visible results?",
            "answer": "<p>Initial epidermal hydration and radiance are typically visible within 24 to 48 hours. Deeper cellular improvements, including skin firmness and texture refinement, peak between 14 to 28 days with consistent daily application.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Are your products cruelty-free and vegan?",
            "answer": "<p>Tenicide is proudly 100% cruelty-free and Leaping Bunny certified. We never test on animals at any stage of product development, and our active formulas are entirely vegan.</p>"
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What is your complimentary shipping and returns policy?",
            "answer": "<p>We offer complimentary carbon-neutral shipping on all domestic orders over $75. If you are not completely satisfied with your skin transformation, we honor a 30-day effortless return guarantee.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
