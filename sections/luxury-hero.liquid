{% comment %}
  Luxury Skincare Hero Section
  Designed for Tenicide Beauty
{% endcomment %}

<div class="luxury-hero-section-wrapper color-scheme-{{ section.settings.color_scheme }}" id="luxury-hero-{{ section.id }}">
  <div class="luxury-hero-container {% if section.settings.full_width %}luxury-hero--full-width{% else %}page-width{% endif %}">
    <div class="luxury-hero-grid luxury-hero--layout-{{ section.settings.layout }}">
      
      <!-- Content Column -->
      <div class="luxury-hero__content-col">
        <div class="luxury-hero__content-inner">
          
          {% if section.settings.kicker != blank %}
            <div class="luxury-hero__kicker">
              <span class="luxury-hero__kicker-dot"></span>
              <span class="luxury-hero__kicker-text">{{ section.settings.kicker | escape }}</span>
            </div>
          {% endif %}

          {% if section.settings.heading != blank %}
            <h1 class="luxury-hero__title">
              {{ section.settings.heading }}
            </h1>
          {% endif %}

          {% if section.settings.subheading != blank %}
            <div class="luxury-hero__subheading">
              {{ section.settings.subheading }}
            </div>
          {% endif %}

          <!-- CTA Buttons -->
          <div class="luxury-hero__actions">
            {% if section.settings.button_label_1 != blank %}
              <a
                href="{{ section.settings.button_link_1 | default: '/collections/all' }}"
                class="button-primary luxury-hero__btn-primary"
              >
                {{ section.settings.button_label_1 | escape }}
              </a>
            {% endif %}

            {% if section.settings.button_label_2 != blank %}
              <a
                href="{{ section.settings.button_link_2 | default: '/pages/about-us' }}"
                class="button-secondary luxury-hero__btn-secondary"
              >
                {{ section.settings.button_label_2 | escape }}
              </a>
            {% endif %}
          </div>

          <!-- Clinical Proof Metrics -->
          {% if section.settings.show_metrics %}
            <div class="luxury-hero__metrics">
              <div class="luxury-hero__metric-item">
                <span class="luxury-hero__metric-val">{{ section.settings.metric_1_val | escape }}</span>
                <span class="luxury-hero__metric-desc">{{ section.settings.metric_1_desc | escape }}</span>
              </div>
              <div class="luxury-hero__metric-divider"></div>
              <div class="luxury-hero__metric-item">
                <span class="luxury-hero__metric-val">{{ section.settings.metric_2_val | escape }}</span>
                <span class="luxury-hero__metric-desc">{{ section.settings.metric_2_desc | escape }}</span>
              </div>
              <div class="luxury-hero__metric-divider"></div>
              <div class="luxury-hero__metric-item">
                <span class="luxury-hero__metric-val">{{ section.settings.metric_3_val | escape }}</span>
                <span class="luxury-hero__metric-desc">{{ section.settings.metric_3_desc | escape }}</span>
              </div>
            </div>
          {% endif %}

        </div>
      </div>

      <!-- Media Column -->
      <div class="luxury-hero__media-col">
        <div class="luxury-hero__media-card">
          {% if section.settings.image != blank %}
            <img
              src="{{ section.settings.image | image_url: width: 1400 }}"
              srcset="
                {{ section.settings.image | image_url: width: 600 }} 600w,
                {{ section.settings.image | image_url: width: 900 }} 900w,
                {{ section.settings.image | image_url: width: 1400 }} 1400w
              "
              sizes="(max-width: 768px) 100vw, 50vw"
              alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
              class="luxury-hero__image"
              loading="eager"
              width="1400"
              height="900"
            >
          {% else %}
            <img
              src="{{ 'luxury-hero-lifestyle.jpg' | asset_url }}"
              alt="Luxury Skincare Routine"
              class="luxury-hero__image"
              loading="eager"
              width="1400"
              height="900"
            >
          {% endif %}

          {% if section.settings.badge_text != blank %}
            <div class="luxury-hero__floating-badge">
              <span class="luxury-hero__badge-star">★</span>
              <span class="luxury-hero__badge-text">{{ section.settings.badge_text | escape }}</span>
            </div>
          {% endif %}
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  #luxury-hero-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#FAF7F5' }};
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: hidden;
    position: relative;
  }

  .luxury-hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .luxury-hero--layout-media_first .luxury-hero__content-col {
    order: 2;
  }

  .luxury-hero--layout-media_first .luxury-hero__media-col {
    order: 1;
  }

  .luxury-hero__content-inner {
    max-width: 580px;
    margin: 0 auto 0 0;
  }

  .luxury-hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.95rem;
    background: rgba(158, 123, 79, 0.1);
    border: 1px solid rgba(158, 123, 79, 0.25);
    border-radius: 9999px;
    margin-bottom: 1.5rem;
  }

  .luxury-hero__kicker-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--lx-gold-primary, #9E7B4F);
    animation: pulse 2s infinite ease-in-out;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .luxury-hero__kicker-text {
    font-family: var(--lx-font-body, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lx-gold-primary, #9E7B4F);
  }

  .luxury-hero__title {
    font-family: var(--lx-font-heading, 'Cormorant Garamond', serif);
    font-size: clamp(2.6rem, 5vw, 4.4rem);
    line-height: 1.08;
    font-weight: 500;
    letter-spacing: -0.02em;
    color: var(--lx-text-primary, #2D2926);
    margin-bottom: 1.4rem;
  }

  .luxury-hero__title em,
  .luxury-hero__title i {
    font-style: italic;
    font-weight: 400;
    color: var(--lx-gold-primary, #9E7B4F);
  }

  .luxury-hero__subheading {
    font-family: var(--lx-font-body, 'Plus Jakarta Sans', sans-serif);
    font-size: 1.05rem;
    line-height: 1.65;
    color: var(--lx-text-secondary, #6E665E);
    margin-bottom: 2.2rem;
  }

  .luxury-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-bottom: 2.8rem;
  }

  .luxury-hero__metrics {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1.8rem;
    border-top: 1px solid var(--lx-border-subtle, #E8E2DC);
  }

  .luxury-hero__metric-item {
    display: flex;
    flex-direction: column;
  }

  .luxury-hero__metric-val {
    font-family: var(--lx-font-heading, 'Cormorant Garamond', serif);
    font-size: 1.7rem;
    font-weight: 700;
    color: var(--lx-gold-primary, #9E7B4F);
    line-height: 1.1;
  }

  .luxury-hero__metric-desc {
    font-family: var(--lx-font-body, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.72rem;
    color: var(--lx-text-secondary, #6E665E);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .luxury-hero__metric-divider {
    width: 1px;
    height: 36px;
    background-color: var(--lx-border-subtle, #E8E2DC);
  }

  .luxury-hero__media-card {
    position: relative;
    border-radius: var(--lx-radius-lg, 16px);
    overflow: hidden;
    box-shadow: 0 20px 48px rgba(45, 41, 38, 0.1);
    border: 1px solid rgba(158, 123, 79, 0.2);
  }

  .luxury-hero__image {
    width: 100%;
    height: 100%;
    max-height: 640px;
    object-fit: cover;
    display: block;
    transition: transform 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .luxury-hero__media-card:hover .luxury-hero__image {
    transform: scale(1.03);
  }

  .luxury-hero__floating-badge {
    position: absolute;
    bottom: 1.8rem;
    left: 1.8rem;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 0.65rem 1.2rem;
    border-radius: 9999px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.12);
    border: 1px solid rgba(158, 123, 79, 0.3);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .luxury-hero__badge-star {
    color: #C69237;
    font-size: 0.9rem;
  }

  .luxury-hero__badge-text {
    font-family: var(--lx-font-body, 'Plus Jakarta Sans', sans-serif);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lx-text-primary, #2D2926);
  }

  @media (max-width: 989px) {
    .luxury-hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .luxury-hero--layout-media_first .luxury-hero__content-col,
    .luxury-hero__content-col {
      order: 1;
    }
    .luxury-hero--layout-media_first .luxury-hero__media-col,
    .luxury-hero__media-col {
      order: 2;
    }
    .luxury-hero__content-inner {
      max-width: 100%;
    }
    .luxury-hero__metrics {
      gap: 1rem;
    }
  }
</style>

{% schema %}
{
  "name": "Luxury Hero Banner",
  "tag": "section",
  "class": "luxury-hero-section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FAF7F5"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop Layout",
      "options": [
        { "value": "text_first", "label": "Text First (Left)" },
        { "value": "media_first", "label": "Media First (Left)" }
      ],
      "default": "text_first"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full Width Container",
      "default": false
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker / Category Tag",
      "default": "Clinically Proven Skincare Innovation"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Elevate Your Skin to its <em>Purest Radiance</em>"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Bio-active formulations engineered with pure botanical actives and dermatologist-backed science for visible, long-lasting transformation."
    },
    {
      "type": "header",
      "content": "Action Buttons"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Primary Button Label",
      "default": "Shop Bestsellers"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Secondary Button Label",
      "default": "Our Clinical Studies"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Secondary Button Link"
    },
    {
      "type": "header",
      "content": "Imagery"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Floating Badge Text",
      "default": "Award-Winning Formula"
    },
    {
      "type": "header",
      "content": "Clinical Metrics"
    },
    {
      "type": "checkbox",
      "id": "show_metrics",
      "label": "Show Proof Metrics",
      "default": true
    },
    {
      "type": "text",
      "id": "metric_1_val",
      "label": "Metric 1 Value",
      "default": "98%"
    },
    {
      "type": "text",
      "id": "metric_1_desc",
      "label": "Metric 1 Label",
      "default": "Firmer Skin"
    },
    {
      "type": "text",
      "id": "metric_2_val",
      "label": "Metric 2 Value",
      "default": "24H"
    },
    {
      "type": "text",
      "id": "metric_2_desc",
      "label": "Metric 2 Label",
      "default": "Hydration Lock"
    },
    {
      "type": "text",
      "id": "metric_3_val",
      "label": "Metric 3 Value",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "metric_3_desc",
      "label": "Metric 3 Label",
      "default": "Pure & Clean"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 140,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 70
    }
  ],
  "presets": [
    {
      "name": "Luxury Hero Banner"
    }
  ]
}
{% endschema %}
